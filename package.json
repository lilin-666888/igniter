{
  "name": "ign",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:setup": "node --env-file=.env scripts/setup-database.mjs",
    "db:generate-seed": "node --import tsx scripts/generate-seed-sql.ts",
    "db:bundle": "npm run db:generate-seed && cat supabase/schema.sql supabase/seed.sql > supabase/full-setup.sql",
    "db:seed": "node --env-file=.env --import tsx scripts/seed-database.ts",
    "db:seed-blog": "node --env-file=.env scripts/seed-blog-posts.mjs"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@supabase/supabase-js": "^2.108.1",
    "eslint": "^10.4.1",
    "nuxt": "^4.4.7",
    "resend": "^6.12.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "pg": "^8.21.0",
    "supabase": "^2.106.0",
    "tsx": "^4.22.4"
  }
}
